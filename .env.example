# Client-side (bundled into the browser; anon key is public by design and protected by RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server/dev-only. NEVER prefix with VITE_. Used only by scripts/seed-dev-users.ts.
# Put real values in .env.local (git-ignored).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# M4.5 grounded generation - SERVER-SIDE ONLY. NEVER prefix with VITE_ (a VITE_ variable is shipped to the browser).
# Put real values in .env.local (git-ignored). With none of these set the pipeline uses the deterministic mock (tests/CI)
# or the extractive fallback; a live call needs ALL THREE below. Review the provider's data-use and privacy terms before
# any real-world use: only aggregate signal facts and evidence passages are ever sent, but they do leave this system.
LLM_PROVIDER=
LLM_MODEL=
GEMINI_API_KEY=
